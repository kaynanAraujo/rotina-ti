# MODELO DE REFERENCIA. Este arquivo nao e carregado automaticamente.
# Defina as variaveis manualmente no Windows, no servico ou no terminal
# antes de iniciar o Rotina TI. Nunca grave segredos no frontend.

PORT=3000
TZ=America/Sao_Paulo

# Gere um valor aleatorio com pelo menos 32 caracteres.
# Se ficar vazio, o sistema usa/cria session-secret.txt.
SESSION_SECRET=

NODE_ENV=development

# O acesso padrao do Rotina TI usa HTTP na rede local: mantenha false.
# Use true somente quando TODO o acesso ocorrer por HTTPS.
SESSION_COOKIE_SECURE=false

# Opcional: caminho absoluto da pasta final dos PDFs de manutencao.
# Vazio mantem a pasta padrao uploads\manutencoes dentro do projeto.
UPLOAD_DIR=
